        }
      }
    },
    "wubu_inventory_event": {
      "type": "function",
      "function": {
        "name": "wubu_inventory_event",
        "description": "按名称/规格/别名在同一后端事务处理已有库存，不拆成先查再写。action=consume 用掉多少、adjust 实际剩多少（可0）、open 开封、finish 用完、discard 丢弃；后三项不填 quantity。spec 是包装规格，与库存数量分开。不存在不创建；ITEM_AMBIGUOUS 要询问用户规格，或选候选ID后使用高级wubu的ID操作，不偷偷选一个。写入 source=agent，幂等键稳定保存，超时不换键重发。购买记账用 record_purchase。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "consume",
                "adjust",
                "open",
                "finish",
                "discard"
              ],
              "title": "Action",
              "type": "string"
            },
            "name": {
              "description": "已有物品的名称或别名，不先查找或创建商品。",
              "maxLength": 80,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "quantity": {
              "description": "consume=用掉量（正数），adjust=实际剩余；其他动作省略。",
              "maximum": 1000000000,
              "minimum": 0,
              "multipleOf": 0.001,
              "title": "Quantity",
              "type": "number"
            },
            "spec": {
              "default": "",
              "description": "已知包装规格；名称有多个规格时先询问。",
              "maxLength": 100,
              "title": "Spec",
              "type": "string"
            },
            "note": {
              "default": "",
              "maxLength": 2000,
              "title": "Note",
              "type": "string"
            },
            "idempotency_key": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "title": "Idempotency Key",
              "type": "string"
            }
          },
          "required": [
            "action",
            "name",
            "idempotency_key"
          ],
          "title": "InventoryInput",
          "type": "object"
        }

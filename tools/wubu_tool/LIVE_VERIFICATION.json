  "schemas": {
    "record_purchase": {
      "type": "function",
      "function": {
        "name": "record_purchase",
        "description": "把一次现实购买记入物簿。只填 items 和稳定 idempotency_key，无需 operation/payload、先查询或创建商品。一瓶2L无糖可乐5.5元：name=无糖可乐,spec=2L,quantity=1,unit=瓶,price=5.5。后端在同一事务匹配或创建商品、记录费用与库存，并默认时间/CNY/source=agent。已知付款填 price 或 total；全未知时后端金额默认0，应向用户说明未确认金额。只在用户有购买记账意图时调用；歧义向用户确认，不随意选；只有成功写入后才能说已记账。根据返回的 purchase_id、expense_amount、库存快照和 warnings 确认；金额或规格警告需请用户核对。超时结果未知，不换键或盲目重试。耐用品、服务费用或复杂账单用高级 wubu.record_purchase_event。",
        "parameters": {
          "$defs": {
            "PurchaseItem": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "商品基础名称，例如无糖可乐；规格单独填 spec。",
                  "maxLength": 80,
                  "minLength": 1,
                  "title": "Name",
                  "type": "string"
                },
                "quantity": {
                  "description": "买了多少库存单位，例如一瓶填 1；2L 是规格，不是数量。",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000,
                  "multipleOf": 0.001,
                  "title": "Quantity",
                  "type": "number"
                },
                "unit": {
                  "description": "库存计数单位，例如瓶、包、个；一瓶2L饮料填瓶。",
                  "maxLength": 20,
                  "minLength": 1,
                  "title": "Unit",
                  "type": "string"
                },
                "price": {
                  "description": "每库存单位的单价，CNY 元；不知道则省略。",
                  "maximum": 10000000,
                  "minimum": 0,
                  "multipleOf": 0.01,
                  "title": "Price",
                  "type": "number"
                },
                "spec": {
                  "default": "",
                  "description": "每包装规格，例如 2L、900ml，不与 name 拼接。",
                  "maxLength": 100,
                  "title": "Spec",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "quantity",
                "unit"
              ],
              "title": "PurchaseItem",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/PurchaseItem"
              },
              "maxItems": 500,
              "minItems": 1,
              "title": "Items",
              "type": "array"
            },
            "total": {
              "description": "实际付款元，选填；省略由明细合计，单商品省略 price 时可由 total 推导。",
              "maximum": 10000000000,
              "minimum": 0,
              "multipleOf": 0.01,
              "title": "Total",
              "type": "number"
            },
            "merchant": {
              "default": "",
              "maxLength": 200,
              "title": "Merchant",
              "type": "string"
            },
            "payment_method": {
              "default": "",
              "maxLength": 100,
              "title": "Payment Method",
              "type": "string"
            },
            "note": {
              "default": "",
              "maxLength": 2000,
              "title": "Note",
              "type": "string"
            },
            "idempotency_key": {
              "description": "每个现实事件稳定保存一个键，重试复用原键及原参数。",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7e]+$",
              "title": "Idempotency Key",
              "type": "string"
            }
          },
          "required": [
            "items",
            "idempotency_key"
          ],
          "title": "RecordPurchaseInput",
          "type": "object"
        }
      }
    },
    "validate_purchase": {
      "type": "function",
      "function": {
        "name": "validate_purchase",
        "description": "预检查购买的名称/规格、金额和预计库存，不写物品、购买、费用、库存或幂等记录。参数与 record_purchase 相同但不需幂等键，只有 items 必填。用于有疑问的账单；返回 warnings 时请用户核对。预检查通过不代表已记账，正式购买用 record_purchase。",
        "parameters": {
          "$defs": {

{
  "manifest_version": 3,
  "name": "Zhaoxi JobApplication Companion",
  "version": "0.1.0",
  "description": "Browser-local, safety-gated assistance for job application forms.",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Zhaoxi JobApplication"
  }
}

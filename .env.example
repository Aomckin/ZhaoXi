ZHAOXI_PROACTIVE_NIGHT_START_HOUR=23
ZHAOXI_PROACTIVE_NIGHT_END_HOUR=8

# v0.6.1 Local Interaction Shell
ZHAOXI_WEB_HOST=127.0.0.1
ZHAOXI_WEB_PORT=4913
ZHAOXI_INTERFACE_SETTINGS_PATH=.zhaoxi/interface-settings.json
ZHAOXI_SESSION_DB_PATH=.zhaoxi/session.db
ZHAOXI_BACKUP_DIRECTORY=.zhaoxi/backups
ZHAOXI_BACKUP_RETENTION_COUNT=14

# v0.7 Desktop Presence (install with: pip install -e .[desktop])
ZHAOXI_DESKTOP_ENABLED=true
ZHAOXI_DESKTOP_INSTANCE_PATH=.zhaoxi/desktop-instance.json
ZHAOXI_DESKTOP_ACTIVATION_PORT=4914
ZHAOXI_DESKTOP_HOTKEY=ctrl+alt+numpad0
ZHAOXI_DESKTOP_COMPANION_HOTKEY=ctrl+alt+numpad1
ZHAOXI_DESKTOP_WINDOW_WIDTH=1080
ZHAOXI_DESKTOP_WINDOW_HEIGHT=760

# v0.7.1 Voice (Windows 10; install with: pip install -e .[desktop,voice])
ZHAOXI_VOICE_ENABLED=false
ZHAOXI_VOICE_AUTO_SEND=false
ZHAOXI_VOICE_AUTO_SPEAK=false
ZHAOXI_VOICE_LANGUAGE=zh-CN
ZHAOXI_VOICE_MAX_SECONDS=60
ZHAOXI_VOICE_MAX_BYTES=4194304
ZHAOXI_VOICE_TEMP_DIR=.zhaoxi/tmp/voice
ZHAOXI_VOICE_DEVICE_NAME=
ZHAOXI_STT_PROVIDER=disabled
ZHAOXI_STT_BASE_URL=
ZHAOXI_STT_API_KEY=
ZHAOXI_STT_MODEL=
ZHAOXI_STT_TIMEOUT_SECONDS=45
ZHAOXI_TTS_PROVIDER=windows
ZHAOXI_TTS_VOICE=
ZHAOXI_TTS_RATE=0
ZHAOXI_TTS_VOLUME=100
ZHAOXI_TTS_MAX_CHARS=1200

# v1.1.2 Intertidal Presence (minutes; no input contents are collected)
ZHAOXI_ACTIVE_TIMEOUT_MINUTES=20
ZHAOXI_SEMI_ACTIVE_TIMEOUT_MINUTES=45
ZHAOXI_AWAY_IDLE_MINUTES=30
ZHAOXI_PROACTIVE_THRESHOLD_ACTIVE=0.45
ZHAOXI_PROACTIVE_THRESHOLD_SEMI_ACTIVE=0.55
ZHAOXI_PROACTIVE_THRESHOLD_IDLE=0.70
# Quick suggestions reuse existing replies; extra LLM calls = 0.
ZHAOXI_QUICK_SUGGESTIONS_REFRESH_MINUTES=180
# v1.1.6 Desktop Activity Awareness (desktop host only)
ZHAOXI_DESKTOP_ACTIVITY_ENABLED=true
ZHAOXI_DESKTOP_ACTIVITY_WINDOW_TITLE_ENABLED=true
ZHAOXI_DESKTOP_ACTIVITY_INPUT_RATE_ENABLED=true
ZHAOXI_DESKTOP_ACTIVITY_TITLE_BUFFER_MINUTES=20
ZHAOXI_DESKTOP_ACTIVITY_SAMPLE_INTERVAL_SECONDS=2
ZHAOXI_DESKTOP_ACTIVITY_INFERENCE_INTERVAL_SECONDS=60
# Rates are observed hook events per minute, not characters or clicks.
ZHAOXI_DESKTOP_ACTIVITY_HIGH_KEYBOARD_RATE=120
# Keyboard busy expires after this many seconds without keyboard input; mouse-only activity never makes HIGH.
ZHAOXI_DESKTOP_ACTIVITY_KEYBOARD_BUSY_GRACE_SECONDS=15
ZHAOXI_DESKTOP_ACTIVITY_HIGH_MOUSE_RATE=180
ZHAOXI_DESKTOP_ACTIVITY_DEEP_WORK_SECONDS=1200
# v1.1.7 Conversation Beat: separate from ordinary proactive events
ZHAOXI_ACTIVE_BEAT_MIN_SILENCE_SECONDS=180
ZHAOXI_ACTIVE_BEAT_COOLDOWN_SECONDS=300
ZHAOXI_ACTIVE_BEAT_INITIAL_BUDGET=2
ZHAOXI_ACTIVE_BEAT_MAX_BUDGET=3

# v1.2.1: desktop-only UI; retain loopback API transport.
ZHAOXI_DEV_BROWSER_UI=false
ZHAOXI_DESKTOP_GEOMETRY_PATH=.zhaoxi/window-geometry.json
# true opts into Windows Toast; otherwise native transient cards are preferred.
ZHAOXI_DESKTOP_SYSTEM_NOTIFICATIONS=false

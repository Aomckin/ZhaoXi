ZHAOXI_MODEL_BASE_URL=https://api.openai.com/v1
ZHAOXI_MODEL_API_KEY=
ZHAOXI_MODEL_NAME=
ZHAOXI_LOG_LEVEL=INFO
ZHAOXI_MAX_AGENT_STEPS=8
ZHAOXI_REQUEST_TIMEOUT_SECONDS=60
ZHAOXI_MAX_CONTEXT_MESSAGES=40
ZHAOXI_MEMORY_DB_PATH=.zhaoxi/memory.db
ZHAOXI_MEMORY_RETRIEVAL_LIMIT=6
ZHAOXI_MEMORY_CONTEXT_MAX_CHARS=4000
ZHAOXI_PLANNER_ENABLED=true
ZHAOXI_PLANNER_MAX_STEPS=12
ZHAOXI_PLANNER_MAX_REPLANS=3
ZHAOXI_PLANNER_MAX_ATTEMPTS_PER_STEP=2
ZHAOXI_PLANNER_STEP_TIMEOUT_SECONDS=30
ZHAOXI_PLANNER_TOTAL_TIMEOUT_SECONDS=180
ZHAOXI_PLANNER_TRACE_MAX_EVENTS=200
ZHAOXI_COGNITIVE_ROUTER_ENABLED=true
ZHAOXI_AUTO_MEMORY_ENABLED=true
